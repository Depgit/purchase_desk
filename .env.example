# Local secrets. Never commit this file.
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:5173
TZ=Asia/Kolkata

POSTGRES_USER=purchasedesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=purchasedesk
DATABASE_URL=postgres://purchasedesk:change-me@db:5432/purchasedesk?sslmode=disable

# 32+ random characters. Signs sessions and encrypts Zoho secrets and bank account numbers.
JWT_SECRET=change-me-to-at-least-32-random-characters
ENCRYPTION_KEY=change-me-to-a-long-random-key-and-never-lose-it

# First System Admin, created on first start if no user exists
ADMIN_EMAIL=admin@saltstayz.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME="System Admin"

# File storage: local (default) or supabase
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/files
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=purchase-desk

# Zoho Books (India data centre). Seeded into Settings > Zoho Books on first start.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
ZOHO_ORG_ID=your-zoho-organisation-id
ZOHO_CLIENT_ID=1000.your-client-id
ZOHO_CLIENT_SECRET=your-client-secret
ZOHO_REFRESH_TOKEN=1000.your-refresh-token
# Push bills to Zoho for real. Keep false until the custom field cf_purchase_desk_id exists on Zoho bills.
ZOHO_PUSH_ENABLED=false

# Email (SMTP) and WhatsApp (MSG91). Left blank: messages are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_OTP_TEMPLATE_ID=

# Load the sample company on first start (sample users sign in with Demo@1234)
SEED_DEMO=true

# Rollout phase switched on: 1 core purchase cycle, 2 Zoho Books, 3 bills, budgets and corporate,
# 4 warehouse and vendor order sheets, 5 everything (dashboards and reports). Change it and restart the API.
RELEASE_PHASE=1
